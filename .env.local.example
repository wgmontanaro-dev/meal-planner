# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# The single shared household password. Anyone with this password can view
# and change all recipes and meal plans. There is no password-reset flow —
# to change it, update this value and redeploy.
APP_SHARED_PASSWORD=Poppy

# Secret used to sign the session cookie (HS256). Generate a long random
# value, e.g. with: openssl rand -base64 48
# Never reuse this value across environments (local/staging/production).
SESSION_SECRET=

# Supabase project connection details (Project Settings -> API in the
# Supabase dashboard). SUPABASE_SERVICE_ROLE_KEY is a privileged secret and
# must only ever be read on the server — never expose it to the browser,
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Name of the Supabase Storage bucket used for recipe images (created in a
# later build stage, but reserved here so deployments can configure it up
# front).
SUPABASE_STORAGE_BUCKET=recipe-images
